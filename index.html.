<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>העוזר החכם</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
    body { background: #f0f2f5; padding: 12px; }
    .settings-box { background: #fff3cd; padding: 10px; border-radius: 8px; margin-bottom: 12px; font-size: 14px; border: 1px solid #ffeeba; }
    .chat-container { background: white; border-radius: 10px; height: 350px; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; border: 1px solid #ccc; }
    .msg { padding: 8px 12px; border-radius: 10px; max-width: 85%; font-size: 15px; }
    .msg.user { background: #0088cc; color: white; align-self: flex-start; }
    .msg.ai { background: #eef2f5; color: #333; align-self: flex-end; }
    .input-row { display: flex; gap: 6px; }
    input { flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 15px; outline: none; }
    .btn { background: #0088cc; color: white; border: none; padding: 10px 14px; border-radius: 8px; font-weight: bold; cursor: pointer; }
  </style>
</head>
<body>

  <!-- תיבת הגדרת המפתח -->
  <div class="settings-box">
    <strong>הדבק את מפתח ה-Gemini שלך כאן:</strong>
    <input type="text" id="keyInput" placeholder="הדבק את המפתח שמתחיל ב-AQ..." style="margin-top: 5px; width: 100%;">
    <button class="btn" onclick="saveKey()" style="margin-top: 6px; width: 100%;">שמור מפתח</button>
  </div>

  <!-- תיבת השיחה עם ה-AI -->
  <div class="chat-container" id="chatBox">
    <div class="msg ai">שלום! אחרי שתשמור את המפתח למעלה, שאל אותי כל שאלה כאן.</div>
  </div>

  <div class="input-row">
    <input type="text" id="userInput" placeholder="כתוב שאלה כאן..." onkeyup="if(event.key==='Enter') sendAI()">
    <button class="btn" onclick="sendAI()">שלח</button>
  </div>

  <script>
    const tg = window.Telegram?.WebApp;
    if (tg) tg.expand();

    // בדיקה אם המפתח כבר שמור במכשיר
    let savedKey = localStorage.getItem("GEMINI_KEY") || "";
    if (savedKey) {
      document.getElementById("keyInput").value = savedKey;
    }

    function saveKey() {
      const val = document.getElementById("keyInput").value.trim();
      if (!val) return alert("אנא הדבק את המפתח");
      localStorage.setItem("GEMINI_KEY", val);
      savedKey = val;
      alert("המפתח נשמר בהצלחה!");
    }

    async function sendAI() {
      if (!savedKey) {
        return alert("קודם כל תדביק את המפתח בתיבה הצהובה למעלה ולחץ 'שמור מפתח'");
      }

      const input = document.getElementById('userInput');
      const box = document.getElementById('chatBox');
      const text = input.value.trim();
      if (!text) return;

      // מציג את השאלה שלך בצ'אט
      box.innerHTML += `<div class="msg user">${text}</div>`;
      input.value = "";
      box.scrollTop = box.scrollHeight;

      // מציג "חושב..."
      const loadId = "load_" + Date.now();
      box.innerHTML += `<div class="msg ai" id="${loadId}">חושב...</div>`;
      box.scrollTop = box.scrollHeight;

      try {
        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${savedKey}`;
        const res = await fetch(url, {
          method: "POST",
          headers: { 
            "Content-Type": "application/json",
            "x-goog-api-key": savedKey
          },
          body: JSON.stringify({ contents: [{ parts: [{ text: text }] }] })
        });
        
        const data = await res.json();
        
        if (data.error) {
          document.getElementById(loadId).innerText = "הודעת שגיאה מגוגל: " + data.error.message;
        } else {
          const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "לא התקבלה תשובה.";
          document.getElementById(loadId).innerText = reply;
        }
      } catch (err) {
        document.getElementById(loadId).innerText = "שגיאה בחיבור לאינטרנט: " + err.message;
      }
      box.scrollTop = box.scrollHeight;
    }
  </script>
</body>
</html>
