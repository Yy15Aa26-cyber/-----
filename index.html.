<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>העוזר החכם</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body { background-color: #f0f2f5; margin: 0; padding: 15px; display: flex; flex-direction: column; height: 100vh; }
    h2 { text-align: center; margin: 0 0 10px 0; color: #0088cc; }
    .box { background: #fff3cd; border: 1px solid #ffeeba; padding: 10px; border-radius: 8px; margin-bottom: 10px; }
    .chat { flex: 1; background: white; border: 1px solid #ddd; border-radius: 8px; padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
    .msg { padding: 8px 12px; border-radius: 8px; max-width: 80%; font-size: 15px; }
    .msg.user { background: #0088cc; color: white; align-self: flex-start; }
    .msg.ai { background: #e9ecef; color: #333; align-self: flex-end; }
    .row { display: flex; gap: 8px; }
    input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 15px; }
    button { background: #0088cc; color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: bold; cursor: pointer; white-space: nowrap; }
  </style>
</head>
<body>

  <h2>העוזר החכם בטלגרם</h2>

  <div id="keyBox" class="box">
    <div style="font-size: 13px; margin-bottom: 5px; font-weight: bold;">הדבק מפתח Gemini:</div>
    <div class="row">
      <input type="text" id="apiKey" placeholder="הדבק כאן מפתח שמתחיל ב-AQ...">
      <button onclick="saveKey()">שמור</button>
    </div>
  </div>

  <div class="chat" id="chatArea">
    <div class="msg ai">שלום! הדבק את המפתח למעלה, שמור אותו, ואז תוכל לשאול אותי כל דבר.</div>
  </div>

  <div class="row">
    <input type="text" id="userInput" placeholder="שאל שאלה..." onkeyup="if(event.key==='Enter') send()">
    <button onclick="send()">שלח</button>
  </div>

  <script>
    const tg = window.Telegram?.WebApp;
    if (tg) tg.expand();

    let key = localStorage.getItem("GEMINI_KEY") || "";
    if (key) {
      document.getElementById("keyBox").style.display = "none";
    }

    function saveKey() {
      const val = document.getElementById("apiKey").value.trim();
      if (!val) return alert("הדבק מפתח תקין");
      localStorage.setItem("GEMINI_KEY", val);
      key = val;
      document.getElementById("keyBox").style.display = "none";
      alert("המפתח נשמר במכשיר בהצלחה!");
    }

    async function send() {
      if (!key) return alert("אנא הדבק ושמור את המפתח למעלה תחילה");
      const input = document.getElementById("userInput");
      const chat = document.getElementById("chatArea");
      const text = input.value.trim();
      if (!text) return;

      chat.innerHTML += `<div class="msg user">${text}</div>`;
      input.value = "";
      chat.scrollTop = chat.scrollHeight;

      const loadId = "load_" + Date.now();
      chat.innerHTML += `<div class="msg ai" id="${loadId}">חושב...</div>`;
      chat.scrollTop = chat.scrollHeight;

      try {
        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${key}`;
        const res = await fetch(url, {
          method: "POST",
          headers: { 
            "Content-Type": "application/json",
            "x-goog-api-key": key
          },
          body: JSON.stringify({ contents: [{ parts: [{ text: text }] }] })
        });
        
        const data = await res.json();
        if (data.error) {
          document.getElementById(loadId).innerText = "שגיאה: " + data.error.message;
        } else {
          document.getElementById(loadId).innerText = data.candidates?.[0]?.content?.parts?.[0]?.text || "אין מענה";
        }
      } catch (err) {
        document.getElementById(loadId).innerText = "שגיאת רשת: " + err.message;
      }
      chat.scrollTop = chat.scrollHeight;
    }
  </script>
</body>
</html>
